  <resolution-body style="multiple-resolved-clause" id="HBODY">
    <section section-type="resolved" id="S1">
      <text>That Kevin McCumber of the State of Illinois be chosen Clerk of the House of Representatives.</text>
    </section>
    <section section-type="resolved" id="S2">
      <text>That William McFarland of the State of Maryland be chosen Sergeant-at-Arms of the House of Representatives.</text>
