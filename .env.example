# Spacious, persistent storage. Defaults to a folder inside this checkout so
# a clean clone works with zero edits; point real deployments at real
# spacious, backed-up storage instead (do not use the OS/root filesystem).
OD_LAKE_ROOT=./data-lake
DATA_ROOT=./data-lake/opendiscourse/raw

# Primary runtime: bare-metal PostgreSQL 17, peer-authenticated as your local
# Unix user. The database's tablespace is on OD_LAKE_ROOT.
DATABASE_URL=postgresql:///opendiscourse?port=5434

# Optional Docker development fallback only.
POSTGRES_DB=research
POSTGRES_USER=research
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# Add only the keys required by enabled plans.
CENSUS_API_KEY=
FRED_API_KEY=
CONGRESS_API_KEY=
# Optional: BLS API v2 works unregistered at a lower daily rate limit.
BLS_API_KEY=

# Only needed to run the dbt/ mart-layer project. dbt-fusion's Postgres
# adapter is experimental and cannot use the app's Unix-socket peer-auth
# connection, so it connects over TCP loopback with this password instead
# (see dbt/profiles.yml). Not read by the research-db CLI itself.
DBT_PG_PASSWORD=
# dbt defaults to the Docker Compose database above. Override all four for
# bare-metal or shared deployments; export this file before invoking dbt.
DBT_PG_HOST=127.0.0.1
DBT_PG_PORT=5433
DBT_PG_USER=research
DBT_PG_DBNAME=research
