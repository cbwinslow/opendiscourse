# Spacious, persistent storage. Defaults to a folder inside this checkout so
# a clean clone works with zero edits; point real deployments at real
# spacious, backed-up storage instead (do not use the OS/root filesystem).
OD_LAKE_ROOT=./data-lake
DATA_ROOT=./data-lake/opendiscourse/raw

# Primary runtime: bare-metal PostgreSQL 17, peer-authenticated as your local
# Unix user. The database's tablespace is on OD_LAKE_ROOT.
DATABASE_URL=postgresql:///opendiscourse?port=5434

# Optional Docker development fallback only.
POSTGRES_DB=research
POSTGRES_USER=research
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# Add only the keys required by enabled plans.
CENSUS_API_KEY=
FRED_API_KEY=
CONGRESS_API_KEY=
