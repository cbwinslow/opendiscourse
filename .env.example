# Spacious, persistent storage. Do not point this at the OS/root filesystem.
OD_LAKE_ROOT=/home/cbwinslow/workspace/data-lake
DATA_ROOT=/home/cbwinslow/workspace/data-lake/opendiscourse/raw

# Primary runtime: bare-metal PostgreSQL 17, peer-authenticated as your local
# Unix user. The database's tablespace is on OD_LAKE_ROOT.
DATABASE_URL=postgresql:///opendiscourse?port=5434

# Optional Docker development fallback only.
POSTGRES_DB=research
POSTGRES_USER=research
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# Add only the keys required by enabled plans.
CENSUS_API_KEY=
FRED_API_KEY=
CONGRESS_API_KEY=

# Only needed to run the dbt/ mart-layer project. dbt-fusion's Postgres
# adapter is experimental and cannot use the app's Unix-socket peer-auth
# connection, so it connects over TCP loopback with this password instead
# (see dbt/profiles.yml). Not read by the research-db CLI itself.
DBT_PG_PASSWORD=
